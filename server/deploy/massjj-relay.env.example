HOST=127.0.0.1
PORT=8787
RELAY_STORAGE=/var/lib/massjj/relay.sqlite
RELAY_TRUST_PROXY=true

RELAY_MAX_MAILBOXES=10000
RELAY_MAX_MESSAGES_PER_MAILBOX=500
RELAY_MAX_MAILBOX_BYTES=16777216
RELAY_MAX_WRITER_BYTES_PER_MAILBOX=8388608
RELAY_MAX_TOTAL_MESSAGE_BYTES=1073741824
RELAY_MAX_REQUESTS_PER_MINUTE=240
RELAY_MAX_WRITES_PER_MINUTE=60

# Normally omit this and preserve the registration key inside relay.sqlite by
# backing up the database. If supplied, use exactly 32 random base64url bytes.
# RELAY_REGISTRATION_KEY=
