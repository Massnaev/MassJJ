[Unit]
Description=MassJJ opaque message relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=massjj
Group=massjj
WorkingDirectory=/opt/massjj/server
EnvironmentFile=/etc/massjj/relay.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/massjj/server/relay.mjs
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/massjj
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
TasksMax=128
MemoryMax=768M

[Install]
WantedBy=multi-user.target
